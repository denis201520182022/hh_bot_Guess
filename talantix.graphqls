"""Exposes a URL that specifies the behaviour of this scalar."""
directive @specifiedBy(
  """The URL that specifies the behaviour of this scalar."""
  url: String!
) on SCALAR

enum ApiTokenErrorType {
  ACCESS_DENIED
}

"""Информация о токене API"""
type ApiTokenItem {
  """Урл, по которому можно получить токен"""
  accessLink: String!

  """Количество дней жизни ссылки токена"""
  accessLinkExpiredInDays: Int!

  """Дата создания токена"""
  createdAt: Instant!

  """
  Название токена. Можно использовать для идентификации системы, в которой используется
  """
  name: String!

  """Статус токена"""
  refreshTokenStatus: ApiTokenStatus!

  """Id токена"""
  tokenId: Int!
}

"""Токены API менеджера или ошибка доступа"""
union ApiTokens = ApiTokensError | ApiTokensItem

type ApiTokensError {
  """Тип ошибки"""
  errorType: ApiTokenErrorType!

  """Сообщение об ошибке"""
  message: String
}

type ApiTokensItem {
  """API токены Talantix"""
  items: [ApiTokenItem!]!
}

"""Статус токена API"""
enum ApiTokenStatus {
  ACTIVE
  EXPIRED
}

"""Событие отправки кандидата на согласование"""
type ApprovalRequest implements PersonEventItem {
  commentHtml: String

  """Время, когда произошло событие"""
  createdAt: Instant!
  creatorManagerId: Int
  id: Int!
  manager: CompanyManager!

  """Кандидат"""
  person: PersonItem

  """Почта согласующего"""
  recipientMail: String!

  """Тип события"""
  type: PersonEventType!

  """Вакансия"""
  vacancy: Vacancy
}

"""Событие отправки на согласование"""
type ApprovalRequested implements HistoryEvent {
  approver: String
  commentHtml: String

  """Время события"""
  eventTime: Instant!
  id: String!

  """Инициатор события"""
  initiator: Initiator

  """Кандидат"""
  person: PersonItem

  """Вакансия"""
  vacancy: Vacancy
}

"""Событие получения ответа на согласовании"""
type ApprovalResponded implements HistoryEvent {
  approved: Boolean!
  approver: String
  commentHtml: String

  """Время события"""
  eventTime: Instant!
  id: String!

  """Инициатор события"""
  initiator: Initiator

  """Кандидат"""
  person: PersonItem

  """Вакансия"""
  vacancy: Vacancy
}

"""Событие получение ответа на запрос на хранение ПД"""
type ApprovalResponse implements PersonEventItem {
  """Ответ согласования"""
  approved: Boolean!

  """Имя согласующего"""
  approver: String!
  commentHtml: String

  """Время, когда произошло событие"""
  createdAt: Instant!
  creatorManagerId: Int
  id: Int!

  """Кандидат"""
  person: PersonItem

  """Тип события"""
  type: PersonEventType!

  """Вакансия"""
  vacancy: Vacancy
}

"""Регион"""
type Area implements Dictionary {
  id: String!

  """Значение элемента справочника"""
  name: String!

  """Id родительского элемента справочника"""
  parentId: String
}

"""Регион"""
input AreaInput {
  """Id региона из справочника areas"""
  id: String!
}

"""Регионы"""
type Areas {
  """Элементы коллекции сущностей"""
  items: [Area!]!
}

"""Значения фильтра про возможность релокации"""
enum AreaSearch {
  """Живут в указанном регионе"""
  LOCATION

  """Живут в указанном регионе или готовы переехать в него"""
  LOCATION_OR_RELOCATION

  """Живут в указанном регионе или готовы к переезду куда-либо"""
  LOCATION_RELOCATION_POSSIBLE

  """Не живут в указанном регионе, но готовы переехать в него"""
  RELOCATION_NOT_LOCATION
}

"""Регионы"""
input AreasInput {
  """Элементы коллекции сущностей"""
  items: [AreaInput!]!
}

"""Событие прикрепления кандидата к вакансии"""
type AttachedToVacancy implements HistoryEvent {
  """Время события"""
  eventTime: Instant!
  id: String!

  """Инициатор события"""
  initiator: Initiator

  """Кандидат"""
  person: PersonItem

  """Вакансия"""
  vacancy: Vacancy
  vacancyMergeSourceWorkflowStatusSnapshot: VacancyMergeSourceWorkflowStatusSnapshot
}

"""События прикрепления кандидата к вакансии и этапу"""
type AttachedToVacancyAndWorkflowStatus implements HistoryEvent {
  """Время события"""
  eventTime: Instant!
  id: String!

  """Инициатор события"""
  initiator: Initiator

  """Кандидат"""
  person: PersonItem
  status: WorkflowStatusSnapshot!

  """Вакансия"""
  vacancy: Vacancy

  """
  Слепок этапа и вакансии с которой кандидат был скопирован в результате объединения вакансий
  """
  vacancyMergeSourceWorkflowStatusSnapshot: VacancyMergeSourceWorkflowStatusSnapshot
}

"""Автодействие, настроенное на этапе"""
type AutoAction {
  """Выбранный шаблон сообщения для автодействия письма"""
  messageTemplate: WithId_Integer

  """Выбранный шаблон тестового задания для соответствующего автодействия"""
  testTaskTemplate: WithId_Integer

  """Тип автодействия"""
  type: AutoActionType!
}

"""Автодействия, настроенные на этапе"""
type AutoActions {
  canEdit: Boolean!

  """Данные автодействий"""
  items: [AutoAction!]!
}

"""Тип автодействия"""
enum AutoActionType {
  """Отправка письма"""
  letter

  """Создание встречи"""
  meeting

  """Отправка тестового задания"""
  testTask
}

enum AvitoConnectionStatus {
  CONNECTED
  NOT_CONNECTED
  PAYMENT_REQUIRED
}

"""Публикация вакансии на Avito"""
type AvitoExternalVacancyItem implements ExternalVacancyItem {
  externalId: String!

  """Причина ошибки импорта откликов"""
  failReason: AvitoFailReason

  """Время привязки публикации"""
  importedAt: Instant!

  """Ссылка на публикацию"""
  link: String!

  """Название вакансии"""
  name: String!

  """Статус импорта откликов с публикации"""
  status: ExternalVacancyImportStatus!

  """Время обновления данных или статуса публикации"""
  updatedAt: Instant!
}

"""Причина ошибки импорта откликов с Avito"""
enum AvitoFailReason {
  ACCOUNT_RECONNECT_REQUIRED
  ACCOUNT_UNSUITABLE_TARIFF
  API_ERROR
  SYSTEM
}

"""Интеграция с Avito"""
type AvitoIntegration implements Integration {
  """Статус подключения"""
  connectionStatus: AvitoConnectionStatus!

  """Можно ли настроить"""
  customizable: Boolean!

  """Является ли временной заглушкой-анонсом"""
  dummy: Boolean!

  """Подключена ли интеграция"""
  enabled: Boolean!

  """Логин в интеграции, отдается если подключена"""
  login: String

  """Url редиректа для OAuth"""
  redirectUrl: String
}

"""Базовый класс менеджера"""
interface BaseManager {
  """Менеджер заблокирован"""
  blocked: Boolean!

  """Email"""
  email: String!

  """Имя"""
  firstName: String!

  """Id менеджера на hh.ru"""
  hhManagerId: Int!
  id: Int!

  """Фамилия"""
  lastName: String

  """Отчество"""
  middleName: String
}

interface BasePerson {
  """Возраст"""
  age: Long

  """Город"""
  area: Area

  """Дата рождения"""
  birthDay: Instant

  """Гражданство"""
  citizenships: Areas

  """Контакты"""
  contacts: Contacts

  """Прикрепленные файлы"""
  files: Files

  """Имя"""
  firstName: String!

  """Пол"""
  gender: Gender

  """Имеются вакансии, к которым можно прикрепить кандидата"""
  hasVacanciesToAttach: Boolean
  hiddenFields: [PersonHiddenField]

  """Фамилия"""
  lastName: String

  """Станция метро"""
  metroStation: MetroStation

  """Отчество"""
  middleName: String
  personalDataAgreement: PersonalDataAgreement

  """Статус согласия на хранение ПД"""
  personalDataAgreementStatus: PersonalDataAgreementStatus @deprecated(reason: "Replaced with personalDataAgreement field")

  """Фотографии кандидата"""
  photos: Photos

  """Отклики"""
  responses: PersonResponses

  """Резюме"""
  resumes: Resumes
  score: Int

  """Источник"""
  source: PersonSource

  """Метки на кандидате"""
  tags: PersonTags

  """Можно открыть контакты с работного сайта"""
  updatableWithContacts: Boolean

  """Можно открыть контакты с hh.ru"""
  updatableWithHHContacts: Boolean @deprecated(reason: "Replaced by updatableWithContacts field")

  """Время обновления"""
  updatedAt: Instant!
}

type BatchLimits {
  changeStatus: Int!
  message: Int!
  personApprovals: Int!
  personsBindToVacancies: Int!
}

"""Базовый объект для нотификаций в колокольчике"""
interface BellNotificationItem {
  """Время события"""
  createdAt: Instant!
  eventUrl: String
  id: Long!

  """Прочитанность"""
  read: Boolean!

  """Тип события"""
  type: BellNotificationType!
}

type BellNotificationPageInfo {
  """
  Курсор последнего элемента. Используется для запроса следующей страницы
  """
  endCursor: String

  """Количество запрошенных элементов на странице"""
  first: Int

  """Имеются ли элементы на следующей странице"""
  hasNextPage: Boolean!
  startCursor: String
}

"""Тип уведомления в колокольчике"""
enum BellNotificationType {
  COMMENT_CREATE
  MEETING_REMINDER
}

"""Готовность к переезду"""
type BusinessTripReadiness implements Dictionary {
  id: String!

  """Значение элемента справочника"""
  name: String!

  """Id родительского элемента справочника"""
  parentId: String
}

type BusinessTripReadinesses {
  """Элементы коллекции сущностей"""
  items: [BusinessTripReadiness!]!
}

"""Готовность к командировкам"""
input BusinessTripReadinessInput {
  """Id готовности к командировкам из справочника businessTripReadinesses"""
  id: String!
}

"""Интеграция с внешним календарем"""
type CalendarIntegration implements Integration {
  """Можно ли настроить"""
  customizable: Boolean!

  """Является ли временной заглушкой-анонсом"""
  dummy: Boolean!

  """Подключена ли интеграция"""
  enabled: Boolean!
  enabledType: CalendarIntegrationType

  """Логин в интеграции, отдается если подключена"""
  login: String
  redirectUrls: CalendarRedirectUrls!
}

"""Тип календаря в интеграции"""
enum CalendarIntegrationType {
  BITRIX
  GOOGLE
  OUTLOOK
  YANDEX
}

type CalendarRedirectUrl {
  type: CalendarIntegrationType!
  url: String!
}

type CalendarRedirectUrls {
  """Элементы коллекции сущностей"""
  items: [CalendarRedirectUrl!]!
}

"""Канал нотификации"""
enum ChannelType {
  BELL
  EMAIL
  POPUP
}

"""Input string with possible html formatting"""
scalar CleanedInputString

"""Тип публикации на hh.ru"""
enum CombinedHhVacancyType {
  ANONYMOUS_PREMIUM
  ANONYMOUS_STANDARD
  DIRECT_PREMIUM
  DIRECT_STANDARD
  FREE
  FREE_CLOSED
  PREMIUM
  STANDARD
  STANDARD_CLOSED
  STANDARD_PLUS
  STANDARD_PLUS_CLOSED
}

"""Комментарий, оставленный в Talantix"""
type Comment implements PersonEventItem {
  canDelete: Boolean!

  """Время, когда произошло событие"""
  createdAt: Instant!
  creatorManagerId: Int
  editable: Boolean
  hhCommentId: Int
  html: String
  id: Int!
  manager: CompanyManager!

  """Кандидат"""
  person: PersonItem
  personRating: PersonRating

  """Тип события"""
  type: PersonEventType!
  updatedAt: Instant!

  """Вакансия"""
  vacancy: Vacancy
  visibility: Visibility!
}

"""Событие добавления комментария"""
type CommentAdded implements HistoryEvent {
  canDelete: Boolean
  commentId: Int!
  editable: Boolean

  """Время события"""
  eventTime: Instant!
  hhCommentId: Int
  html: String
  id: String!

  """Инициатор события"""
  initiator: Initiator

  """Кандидат"""
  person: PersonItem
  personRating: PersonRating
  updatedAt: Instant

  """Вакансия"""
  vacancy: Vacancy
  visibility: Visibility
}

"""Нотификация в колокольчике о создании комментария"""
type CommentCreateBellNotificationItem implements BellNotificationItem {
  authorId: Int!

  """Имя автора"""
  authorName: String!

  """Время события"""
  createdAt: Instant!
  eventUrl: String
  id: Long!
  personId: Int!

  """Имя кандидата"""
  personName: String!

  """Url фото кандидата"""
  photoUrl: String

  """Прочитанность"""
  read: Boolean!

  """Тип события"""
  type: BellNotificationType!
  vacancyId: Int

  """Название вакансии, в рамках которой оставлен комментарий"""
  vacancyName: String

  """Этап, на котором оставлен комментарий"""
  workflowStatusName: String
}

"""Комментарий"""
input CommentInput {
  text: CleanedInputString!
}

"""Настройки видимости комментария"""
input CommentVisibilityInput {
  """Видим для всех"""
  visibleForAll: Boolean!

  """ID менеджеров, для которых виден комментарий"""
  visibleForManagerIds: [Int]
}

type CompanyApprovingManager implements BaseManager {
  """Менеджер заблокирован"""
  blocked: Boolean!

  """Email"""
  email: String!

  """Имя"""
  firstName: String!

  """Id менеджера на hh.ru"""
  hhManagerId: Int!
  id: Int!

  """Фамилия"""
  lastName: String

  """Отчество"""
  middleName: String
}

"""Результат изменения информации о компании"""
union CompanyInfoUpdated = CompanyInfoUpdateError | CompanyItem

"""Ошибка изменения информации о компании"""
type CompanyInfoUpdateError {
  """Тип ошибки"""
  errorType: CompanyInfoUpdateErrorType!

  """Ошибки валидации"""
  errors: [FieldErrors!]

  """Сообщение об ошибке"""
  message: String
}

"""Тип ошибки создания информации о компании"""
enum CompanyInfoUpdateErrorType {
  ACCESS_DENIED
  FIELDS_VALIDATION
}

"""Модель изменения информации о компании"""
input CompanyInfoUpdateInput {
  """ИНН"""
  inn: String!

  """Юридический адрес компании"""
  legalAddress: CleanedInputString!

  """Юридическое название компании"""
  legalName: CleanedInputString!

  """Название компании"""
  name: CleanedInputString!
}

"""Данные компании"""
type CompanyItem {
  """ИНН. Используется в согласии на хранение ПД"""
  inn: String

  """Юридический адрес компании. Используется в согласии на хранение ПД"""
  legalAddress: String

  """Юридическое название компании. Используется в согласии на хранение ПД"""
  legalName: String

  """Внутреннее название компании"""
  name: String

  """Список причин отказа кандидата"""
  personDiscardReasons(initiator: PersonDiscardInitiator!, sortBy: PersonDiscardReasonSortType!): PersonDiscardReasons!

  """Источники кандидатов"""
  personSources(
    """Фильтр источников кандидатов"""
    filter: PersonSourceFilterInput

    """Курсор пагинации"""
    afterCursor: String

    """Количество запрашиваемых источников, максимум 100"""
    first: Int = 50
  ): PersonSources!

  """Теги кандидатов"""
  personTags: PersonTags!

  """Текущий тариф компании"""
  tariff: CompanyTariff!
}

"""Менеджер в компании"""
type CompanyManager implements BaseManager {
  """Менеджер заблокирован"""
  blocked: Boolean!

  """Email"""
  email: String!

  """Имя"""
  firstName: String!

  """Id менеджера на hh.ru"""
  hhManagerId: Int!
  id: Int!

  """Фамилия"""
  lastName: String

  """Вид лицензии"""
  licenseType: ManagerLicenseType!

  """Роль"""
  managerRole: ManagerRole!

  """Отчество"""
  middleName: String
}

"""Менеджеры компании или ошибка доступа"""
union CompanyManagers = Managers | ManagersError

"""Данные о тарифе компании"""
type CompanyTariff {
  """Дата окончания срока действия тарифа"""
  endAt: Instant

  """Лицензии тарифа"""
  licenses: [TariffLicense!]!

  """Название тарифа"""
  name: Tariff!

  """Дата начала срока действия тарифа"""
  startAt: Instant

  """Тип платного тарифа"""
  type: PaidTariffType
}

"""Основание для отзыва согласия на хранение ПД"""
enum ConsentRevokeCause {

  """Название вакансии"""
  title: String!

  """Менеджеры на вакансии"""
  vacancyManagers(filter: [VacancyRole] = []): VacancyManagers
}

"""Результат открепления кандидата от вакансии"""
union VacancyResponseDetached = VacancyResponseDetachError | VacancyResponseDetachedSuccess

"""Успешное открепление кандидата от вакансии"""
type VacancyResponseDetachedSuccess {
  message: String
}

"""Ошибка открепления кандидата от вакансии"""
type VacancyResponseDetachError {
  """Тип ошибки"""
  errorType: VacancyResponseDetachErrorType!

  """Сообщение об ошибке"""
  message: String
}

"""Тип ошибки открепления кандидата от вакансии"""
enum VacancyResponseDetachErrorType {
  ACCESS_DENIED
  NOT_FOUND
}

"""Роль менеджера на вакансии"""
enum VacancyRole {
  """Ответственный"""
  owner

  """Рекрутер"""
  recruiter

  """Наблюдатель"""
  watcher
}

"""Тип сортировки вакансий"""
enum VacancySortType {
  """По дате прикрепления кандидата"""
  LAST_USED_DATE

  """По имени"""
  NAME
  OPENED_DATE @deprecated(reason: "Используйте STATUS_UPDATED_DATE")

  """По планируемой дате закрытия"""
  PROPOSED_DATE_OF_CLOSE

  """По дате смены статуса"""
  STATUS_UPDATED_DATE
}

type VacancySource {
  href: String
  type: VacancySourceType!
}

enum VacancySourceType {
  hh
  scoring
  tms
}

"""Статус вакансии"""
enum VacancyStatus {
  """Активная вакансия"""
  ACTIVE

  """Архивная вакансия"""
  ARCHIVE
}

type VacancySubscriptionsError {
  """Тип ошибки"""
  errorType: VacancySubscriptionsErrorType!

  """Сообщение об ошибке"""
  message: String
}

enum VacancySubscriptionsErrorType {
  NOT_FOUND
}

type VacancySubscriptionsItem {
  workflowStatuses: ItemsWithId_Integer!
}

type Visibility {
  managerIds: [Int] @deprecated(reason: "use managers")
  managers: [CompanyManager!]!
  visibleForAll: Boolean!
}

"""Интеграция с IP телефонией Voximplant"""
type VoximplantIntegration implements Integration {
  """Можно ли настроить"""
  customizable: Boolean!

  """Является ли временной заглушкой-анонсом"""
  dummy: Boolean!

  """Подключена ли интеграция"""
  enabled: Boolean!

  """Логин в интеграции, отдается если подключена"""
  login: String
  node: String
}

"""Событие неуспешного звонка"""
type WebCallFailure implements HistoryEvent {
  """Время события"""
  eventTime: Instant!
  id: String!

  """Инициатор события"""
  initiator: Initiator

  """Кандидат"""
  person: PersonItem
  phoneNumber: String!

  """Вакансия"""
  vacancy: Vacancy
}

"""Событие успешного звонка"""
type WebCallSuccess implements HistoryEvent {
  durationSeconds: Int!

  """Время события"""
  eventTime: Instant!
  id: String!

  """Инициатор события"""
  initiator: Initiator

  """Кандидат"""
  person: PersonItem
  phoneNumber: String!
  recordUrl: String

  """Вакансия"""
  vacancy: Vacancy
}

"""Класс для простых объектов, содержащих только id"""
type WithId_Integer {
  id: Int!
}

"""Опыт работы"""
enum WorkExperience {
  """Без опыта"""
  NO_WORK_EXPERIENCE

  """От 1 года до 3 лет"""
  WORK_EXPERIENCE_FROM_1_YEAR_TO_3_YEAR

  """От 3 до 6 лет"""
  WORK_EXPERIENCE_FROM_3_YEAR_TO_6_YEAR

  """Менее 1 года"""
  WORK_EXPERIENCE_LESS_THAN_1_YEAR

  """Более 6 лет"""
  WORK_EXPERIENCE_MORE_THAN_6_YEAR
}

"""Этап вакансии или ошибка"""
union WorkflowStatus = WorkflowStatusError | WorkflowStatusItem | WorkflowStatusPublicItem

"""Событие перевода кандидата по вакансии"""
type WorkflowStatusChanged implements HistoryEvent {
  discardInfo: DiscardInfo

  """Время события"""
  eventTime: Instant!

  """Источник ставки"""
  hiringPositionSource: HiringPositionSource
  id: String!

  """Инициатор события"""
  initiator: Initiator

  """Кандидат"""
  person: PersonItem

  """Тип операции перевода кандидата"""
  processType: ProcessType
  status: WorkflowStatusSnapshot!

  """Вакансия"""
  vacancy: Vacancy
}

type WorkflowStatusError {
  """Тип ошибки"""
  errorType: WorkflowStatusErrorType!

  """Сообщение об ошибке"""
  message: String
}

enum WorkflowStatusErrorType {
  NOT_FOUND
}

"""Этапы вакансии"""
type WorkflowStatuses {
  """Первый этап вакансии"""
  first: WorkflowStatusItem!

  """Данные этапов"""
  items: [WorkflowStatusItem]!
}

"""Этап вакансии"""
type WorkflowStatusItem {
  """Автодействия, настроенные на этапе"""
  autoActions: AutoActions!

  """Список id этапов, на которые можно перевести кандидата с текущего"""
  availableForTransferWorkflowStatuses: ItemsWithId_Integer
  id: Int!

  """
  Список этапов на hh.ru с которых производится импорта откликов на данный этап
  """
  importFromHhStatuses: [String]!

  """Является ли статус источником автофильтра"""
  isAutoFilterSource: Boolean
  name: String!

  """Счетчики кандидатов"""
  personCounters: PersonCounters
  position: Int!

  """Отклики на этапе вакансии"""
  responses(
    """Фильтры кандидатов на вакансии"""
    filter: ResponseFilterInput

    """Сортировка кандидатов на вакансии"""
    sortBy: ResponsesSortType

    """Курсор пагинации"""
    after: String

    """Количество запрашиваемых откликов"""
    first: Int = 50
  ): Responses!

  """Настройки ограничения времени нахождения на этапе"""
  sla: SLA!

  """Тип этапа"""
  statusType: WorkflowStatusType!

  """Вакансия, которой принадлежит этап"""
  vacancy: Vacancy
}

"""Данные этапа, доступные через список откликов кандидата"""
type WorkflowStatusPublicItem {
  id: Int!
  name: String!

  """Вакансия, которой принадлежит этап"""
  vacancy: Vacancy
}

"""Слепок этапа вакансии в момент события с кандидатом"""
type WorkflowStatusSnapshot {
  id: Int!
  name: String!
}

"""Тип этапа"""
enum WorkflowStatusType {
  """Оценка"""
  ASSESSMENT

  """Подумать"""
  CONSIDER

  """Пользовательский"""
  CUSTOM

  """Отказ"""
  DISCARDED

  """Выход на работу"""
  HIRED

  """Неразобранные"""
  INBOX

  """Интервью"""
  INTERVIEW

  """Предложение о работе"""
  OFFER

  """Телефонное интервью"""
  PHONE_INTERVIEW

  """Из предложенных"""
  SUGGEST
}

"""График работы"""
enum WorkSchedule {
  """Не имеет значения"""
  any

  """Гибкий график"""
  flexible

  """Вахтовый метод"""
  flyinflyout

  """Полный день"""
  fullday

  """Удаленная работа"""
  remote

  """Сменный график"""
  shift
}

type WorkTicket implements Dictionary {
  id: String!

  """Значение элемента справочника"""
  name: String!

  """Id родительского элемента справочника"""
  parentId: String
}

"""Регион, в котором соискатель имеет разрешение на работу"""
input WorkTicketInput {
  """Id региона из справочника areas"""
  id: String!
}

type WorkTickets {
  """Элементы коллекции сущностей"""
  items: [WorkTicket!]!
}

"""Интеграция с Zarplata"""
type ZarplataIntegration implements Integration {
  """Можно ли настроить"""
  customizable: Boolean!

  """Является ли временной заглушкой-анонсом"""
  dummy: Boolean!

  """Подключена ли интеграция"""
  enabled: Boolean!

  """Логин в интеграции, отдается если подключена"""
  login: String

  """Url редиректа для OAuth"""
  redirectUrl: String
}

"""Интеграция с Zoom"""
type ZoomIntegration implements Integration {
  """Можно ли настроить"""
  customizable: Boolean!

  """Является ли временной заглушкой-анонсом"""
  dummy: Boolean!

  """Подключена ли интеграция"""
  enabled: Boolean!

  """Логин в интеграции, отдается если подключена"""
  login: String

  """URL редирект для OAuth"""
  redirectUrl: String
}

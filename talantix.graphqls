  """Пол"""
  gender: Gender

  """Имеются вакансии, к которым можно прикрепить кандидата"""
  hasVacanciesToAttach: Boolean
  hiddenFields: [PersonHiddenField]

  """История работы с кандидатом"""
  history(
    """Курсор пагинации"""
    after: String

    """Количество запрашиваемых событий"""
    first: Int = 50
  ): History
  id: Int!

  """Фамилия"""
  lastName: String

  """Превью результата объединения кандидатов"""
  mergePreviewPerson(personIds: [Int]!): MergePreviewPerson

  """Переписка с кандидатом по почте"""
  messages(
    """Курсор пагинации"""
    after: String

    """Количество запрашиваемых сообщений"""
    first: Int = 50
  ): PersonMessages

  """Станция метро"""
  metroStation: MetroStation

  """Отчество"""
  middleName: String
  personalDataAgreement: PersonalDataAgreement

  """Статус согласия на хранение ПД"""
  personalDataAgreementStatus: PersonalDataAgreementStatus @deprecated(reason: "Replaced with personalDataAgreement field")

  """Фотографии кандидата"""
  photos: Photos

  """Отклики кандидата"""
  responses: PersonResponses

  """Резюме кандидата"""
  resumes: Resumes
  score: Int
  similarPersons: Persons

  """Источник"""
  source: PersonSource

  """Статус отправки кандидата в Start Link"""
  startLinkPersonStatus: StartLinkPersonStatus

  """Метки на кандидате"""
  tags: PersonTags

  """Тестовые задания кандидата"""
  testTasks(
    """Курсор пагинации"""
    after: String = "0"

    """Количество запрашиваемых тестовых заданий"""
    first: Int = 50
  ): TestTasks

  """Можно открыть контакты с работного сайта"""
  updatableWithContacts: Boolean

  """Можно открыть контакты с hh.ru"""
  updatableWithHHContacts: Boolean @deprecated(reason: "Replaced by updatableWithContacts field")

  """Время обновления"""
  updatedAt: Instant!
}


"""Mutation root"""
type Mutation {
  """Отзыв заявки на подбор"""
  withdrawHiringRequest(hiringRequestInput: HiringRequestWithdrawInput!): HiringRequestWithdrawn!

  """Отправка кандидата в Start Link"""
  sendPersonToStartLink(personId: Int!, vacancyId: Int): StartLinkPersonSent!

  """Создание заявки на подбор"""
  createHiringRequest(hiringRequestInput: HiringRequestCreateInput!): HiringRequestCreated!

  """Удаление поля шаблона заявки на подбор"""
  deleteHiringRequestTemplateField(hiringRequestTemplateFieldId: Int!): HiringRequestTemplateFieldDeleted!

  """Создание источника кандидата"""
  createPersonSource(personSourceCreate: String!): PersonSourceCreated!

  """Перемещение кандидатов на этап "Выход на работу" вакансии"""
  hirePersons(hiringPositionSource: HiringPositionSourceInput, personIds: [Int!]!, vacancyId: Int!): PersonsHired!

  """Запрос согласования заявки"""
  requestHiringRequestApprove(hiringRequestId: Int!): HiringRequestApproveRequested!

  """Редактирование кандидата"""
  editPerson(personEdit: PersonEditInput!): PersonCreated!

  """Создание комментария по кандидату"""
  createPersonComment(commentCreate: PersonCommentCreateInput!): PersonCommentCreated!

  """Удаление отклика кандидата на вакансии"""
  deleteResponse(personId: Int!, vacancyId: Int!): ResponseDeleted!

  """Отправка запроса на обработку персональных данных"""
  sendPersonalDataRequest(personIds: [Int!]!): PersonalDataRequestSent!

  """Перемещение кандидатов на этап вакансии"""
  transferPersonsToWorkflowStatus(personIds: [Int!]!, workflowStatusId: Int!): PersonsToWorkflowStatusTransferred!

  """Удаление источника у кандидата"""
  deletePersonSource(personId: Int!): PersonSourceDeleted!

  """Создание причины отказа по кандидату"""
  createPersonDiscardReason(discardReasonCreate: DiscardReasonCreateInput!): PersonDiscardReasonCreated!

  """Отклонение заявки на подбор"""
  declineHiringRequest(hiringRequestId: Int!): HiringRequestDeclined!

  """Открепление кандидата от вакансии"""
  detachVacancyResponse(personId: Int!, vacancyId: Int!): VacancyResponseDetached! @deprecated(reason: "use deleteResponse mutation")

  """Отключение интеграции"""
  disableIntegration(integrationType: IntegrationType!): IntegrationDisabled!

  """Изменение заявки на подбор"""
  updateHiringRequest(hiringRequestInput: HiringRequestUpdateInput!): HiringRequestUpdated!

  """Создание откликов кандидатов на вакансиях"""
  createResponses(vacancyIds: [Int!]!, personIds: [Int!]!): ResponsesCreated!

  """Приглашение кандидатов на hh.ru"""
  invitePersonsOnHhRu(inviteMessage: PersonHhInviteMessageInput, personIds: [Int!]!, workflowStatusId: Int, vacancyId: Int!): PersonsHhInvited!

  """Обновление комментария по кандидату"""
  updatePersonComment(commentUpdate: PersonCommentUpdateInput!): PersonCommentUpdated!

  """Создание кандидата"""
  createPerson(personCreate: PersonCreateInput!): PersonCreated!

  """Перемещение кандидатов на этап "Отказ" вакансии"""
  discardPersons(personIds: [Int!]!, comment: CommentInput, discardMessage: PersonDiscardMessageInput, discardReasonIds: [Int!], vacancyId: Int!): PersonsDiscarded!

  """Добавление поля шаблона заявки на подбор"""
  createHiringRequestTemplateField(hiringRequestTemplateFieldInput: HiringRequestTemplateCreateFieldInput!): HiringRequestTemplateFieldCreated!

  """Создание тега кандидата"""
  createPersonTag(personTagCreate: PersonTagCreateInput!): PersonTagCreated!

  """Изменение поля шаблона заявки на подбор"""
  updateHiringRequestTemplateField(hiringRequestTemplateFieldInput: HiringRequestTemplateUpdateFieldInput!, hiringRequestTemplateFieldId: Int!): HiringRequestTemplateFieldUpdated!

  """Открытие контактов кандидата"""
  openPersonContacts(personId: Int!): PersonContactsOpened!

  """Удаление комментария по кандидату"""
  deletePersonComment(commentId: Int!): PersonCommentDeleted!

  """Изменение источника у кандидата"""
  updatePersonSource(personSourceUpdate: PersonSourceUpdateInput!): PersonSourceUpdated!

  """Утверждение заявки на подбор и создание вакансии"""
  approveHiringRequest(hiringRequestId: Int!, vacancyOwnerManagerId: Int, vacancyId: Int): HiringRequestApproved!

  """Изменение информации о компании"""
  updateCompanyInformation(companyInfo: CompanyInfoUpdateInput!): CompanyInfoUpdated!
}


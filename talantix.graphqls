"""Query root"""
type Query {
  """Этап вакансии"""
  workflowStatus(id: Int!): WorkflowStatus!

  """Заявка на вакансию"""
  hiringRequest(id: Int!): HiringRequest!

  """Регионы"""
  areas(
    """Признак получения только гражданств"""
    onlyCitizenships: Boolean = false
  ): Areas! @deprecated(reason: "Use dictionaries { areas } instead")

  """Информация о себе"""
  me: Me!

  """Список кандидатов"""
  persons(
    """Фильтры списка кандидатов"""
    filter: PersonFilterInput

    """Значения курсора пагинации"""
    after: String

    """Количество запрашиваемых кандидатов, максимум 50"""
    first: Int = 50
  ): Persons!

  """Ссылки на согласование кандидата"""
  personApprovalLinks(personIds: [Int!]!, vacancyId: Int!): PersonApprovalLinks

  """Кандидат по id"""
  person(
    """id кандидата"""
    id: Int!
  ): Person

  """Вакансия"""
  vacancy(id: Int!): Vacancy!

  """Шаблон заявки на подбор"""
  hiringRequestTemplate: HiringRequestTemplate!

  """Менеджеры в вашей регистрации"""
  managers(
    """Фильтры списка менеджеров"""
    filter: ManagerFilterInput

    """Тип сортировки менеджеров"""
    sortType: ManagerSortTypeInput

    """Значения курсора пагинации"""
    after: String

    """Количество запрашиваемых менеджеров, максимум 50"""
    first: Int
  ): CompanyManagers!

  """Справочники"""
  dictionaries: Dictionaries!

  """Источники кандидатов"""
  personSources(
    """Фильтр по имени"""
    filterByName: String

    """Курсор пагинации"""
    afterCursor: String

    """Количество запрашиваемых источников, максимум 50"""
    first: Int = 50
  ): PersonSources!

  """Менеджеры в компании, добавленные на hh.ru"""
  hhManagers(filter: HhManagersFilterInput): HhManagers

  """Заявки на вакансии"""
  hiringRequests(
    """Фильтр списка заявок"""
    filter: HiringRequestFilterInput

    """Курсор пагинации"""
    after: String

    """Количество запрашиваемых заявок"""
    first: Int = 50
  ): HiringRequests!

  """Компания текущей регистрации"""
  company: CompanyItem!

  """Информация о менеджере компании"""
  manager(id: Int!): Manager!

  """Список вакансий"""
  vacancies(
    """Фильтры списка вакансий"""
    filter: VacancyFilterInput

    """Признак сортировки по возрастанию"""
    sortAsc: Boolean = true

    """Тип сортировки"""
    sortBy: VacancySortType = NAME

    """Курсор пагинации"""
    after: String

    """Количество запрашиваемых вакансий, максимум 200"""
    first: Int = 50
  ): Vacancies!

  """Шаблоны сообщений"""
  messageTemplates(
    """Параметры для замены плейсхолдеров"""
    replaceParams: MessageTemplateReplaceParamsInput
  ): MessageTemplates

  """Отклик по кандидату и вакансии"""
  response(personId: Int!, vacancyId: Int!): Response
}

